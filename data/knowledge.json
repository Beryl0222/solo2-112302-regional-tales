  "terms": [
    {
      "id": "term:ban",
      "term": "版",
      "current_version": 1,
      "versions": [
        {
          "version": 1,
          "label": "旧术语解释",
          "definition": "‘版’指印版；‘最后一版’被解作最后刻出的一块板或一个完整版本，该版印完后母版被摧毁。",
          "source_ids": [
            "g1"
          ],
          "known_problem": "容易把逐版递减的同一母版误实体化为先后不同的新版/独立作品，并把 g1/h0 的顺承叙事当成制作事实。"
        }
      ],
      "revision": {
        "version": 2,
        "label": "修订术语解释",
        "definition": "在绝版木刻中，‘版’首先指套色版次，即同一母版边刻边印、逐版递减过程中的一个刻印状态或色层；它不是另一块板，不是一个独立版本，也不是一张独立作品。",
        "senses": [
          {
            "id": "sense:ban:state",
            "label": "套色版次：同一母版逐版递减的刻印状态/色层。"
          },
          {
            "id": "sense:ban:state_exhausted",
            "label": "版次终点：母版板面被刻尽，即‘版已经用完了’。"
          },
          {
            "id": "sense:ban:sheet_count",
            "label": "张数/印数：‘一张’指印出的纸张或成品张数，按张计数。"
          },
          {
            "id": "sense:ban:edition",
            "label": "出版物意义上的版本/版次：本批口述材料无证据采用。"
          },
          {
            "id": "sense:ban:plate_or_version",
            "label": "旧解释中未分化的‘一块板/一个版本’，修订后停止作为实体链接目标。"
          }
        ],
        "review_rule": "修订术语不是全文替换：所有含‘版/板’字样，或链接到母版、刻版、套印、刻毁、红土事件的口述句、展厅稿、课堂稿与作品说明，都必须逐条重新判断实体链接，并留下复核结论；原始口述文字一律不改。"
      }
    }
  ],
